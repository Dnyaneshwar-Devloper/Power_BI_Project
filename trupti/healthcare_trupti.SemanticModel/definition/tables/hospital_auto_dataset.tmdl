		sourceColumn: Bill_Amount

		annotation SummarizationSetBy = Automatic

	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    hospital_auto_dataset[Age] <= 17, "0-17",
			    hospital_auto_dataset[Age] <= 29, "18-29",
			    hospital_auto_dataset[Age] <= 44, "30-44",
			    hospital_auto_dataset[Age] <= 59, "45-59",
			    "60+"
			)
		lineageTag: e0b7e4f8-88d0-45e0-b9c6-28bbdbfef1ed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Age Group Sort' =
			
			SWITCH(
			    hospital_auto_dataset[Age Group],
			    "0-17", 1,
			    "18-29", 2,
			    "30-44", 3,
			    "45-59", 4,
			    "60+", 5
			)
		formatString: 0
		lineageTag: d956c939-376b-459e-85b9-dc1c56ac7a7d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Admission Date' =
			
			DATE(
			    YEAR(hospital_auto_dataset[Timestamp]),
			    MONTH(hospital_auto_dataset[Timestamp]),
			    DAY(hospital_auto_dataset[Timestamp])
			)
		formatString: Long Date
		lineageTag: 043ffebc-b532-41ff-a1d3-a6074e57abd7
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 604c0467-88c0-40bb-892a-fb6dff69370c
			defaultHierarchy: LocalDateTable_553017d0-a0a3-4b09-954e-69eabbe8dbf4.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Average Daily Patients' =
			
			DIVIDE(
			    [Total Patients],
			    DISTINCTCOUNT(hospital_auto_dataset[Admission Date])
			)
		lineageTag: 0ab8e31f-61fa-4895-b1bf-e74b9da7cb37
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

