table 'Dax Measures (2)'
	lineageTag: d7e7a99a-5c87-4c7a-b999-091e1cb68b23

	measure 'Total Sales' = Sum('dataset'[Sales])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2e8578d3-c961-45f9-ad51-3af309560e13

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Sales' = AVERAGE('dataset'[Sales])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 66228dfd-113c-4baa-a42d-5e77ca4670fb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'No of Items' = COUNT('dataset'[Item Identifier])
		formatString: #,0
		lineageTag: a20ed9e8-a80f-4d03-a362-6f9104a22856

	measure 'Avg Rating' = AVERAGE('dataset'[Rating])
		formatString: 0.0
		lineageTag: 7e7a14e8-2392-48fa-8572-bad5ac3ecc4f

	measure 'Total Oulets' = DISTINCTCOUNT('dataset'[Outlet Identifier])
		formatString: 0
		lineageTag: a3212f94-8ad2-43e5-9d18-e0c4a7f684c7

	measure 'Best Outlet Sales' =
			
			MAXX(
			    VALUES('dataset'[Outlet Identifier]),
			    [Total Sales])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b0292192-f4a9-4d62-b041-557905b0ca60

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Sales per Outlet' =
			DIVIDE(
			    [Total Sales], [Total Oulets])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 152d6143-67ab-4a48-be1c-7ce680f6cb48

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	partition 'Dax Measures (2)' = m
		mode: import
		source =
